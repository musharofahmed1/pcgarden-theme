{% liquid 
  assign logo = section.settings.logo 
  assign menu = section.settings.menu 
  assign enable_search = section.settings.enable_search_box 
%}

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">

    {% if logo != null %}
      {% comment %} <img src="{{ logo | img_url:width:200 }}" alt=""> {% endcomment %}
    {% else %}
      <a class="navbar-brand" href="#"><span class="path">PATH</span><span class="way">WAY</span></a>
    {% endif %}

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

        {% for link in menu.links %}
          <li class="nav-item {% if link.links.size > 0 %} dropdown {% endif %}">

            <a class="nav-link {% if link.links.size > 0 %} dropdown-toggle {% endif %}"
              href="{{ link.url }}"
              {% if link.links.size > 0 %}
                id="navbarDropdown_{{ forloop.index }}"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              {% endif %}
            >
              {{ link.title }}
            </a>

            {% if link.links.size > 0 %}
              <ul class="dropdown-menu">
                {% for dropLink in link.links %}
                  <li>
                    <a class="dropdown-item" href="{{ dropLink.url }}">
                      {{ dropLink.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

          </li>
        {% endfor %}
      </ul>
     <li class="purchase-button">Purchase Now</li>
      {% if enable_search %}
        <form class="d-flex" role="search">
          <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
          <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
      {% endif %}

    </div>
  </div>
</nav>

{% schema %}
{
  "name": "header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "select logo",
      "info": "Recommended Size : 200px X 200px"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Search Bar"
    },
    {
      "type": "checkbox",
      "id": "enable_search_box",
      "label": "Enable Search Box",
      "default": true
    }
  ]
}
{% endschema %}
